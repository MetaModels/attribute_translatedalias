<?xml version="1.0" ?><xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" datatype="plaintext" original="src/Resources/translations/tl_metamodel_attribute.en.xlf" target-language="de">
    <body>
      <trans-unit id="typeOptions.translatedalias" resname="typeOptions.translatedalias">
        <source>Translated alias</source>
        <target>Übersetzter Alias</target>
      </trans-unit>
      <trans-unit id="noIntegerPrefix.label" resname="noIntegerPrefix.label">
        <source>No integer prefix</source>
        <target>Kein Integer-Präfix</target>
      </trans-unit>
      <trans-unit id="noIntegerPrefix.description" resname="noIntegerPrefix.description">
        <source>Trim the &quot;id-&quot; prefix for alias that are numeric.</source>
        <target>Entfernt das Präfix &quot;id-&quot; bei numerischen Aliasen.</target>
      </trans-unit>
      <trans-unit id="prepostfix_fields.label" resname="prepostfix_fields.label">
        <source>Alias prefix and postfix</source>
        <target>Alias-Präfix und -Postfix</target>
      </trans-unit>
      <trans-unit id="prepostfix_fields.description" resname="prepostfix_fields.description">
        <source>Please enter optional prefix and/or postfix.</source>
        <target>Bitte geben Sie optional Präfix und/oder Postfix ein.</target>
      </trans-unit>
      <trans-unit id="prepostfix_language.label" resname="prepostfix_language.label">
        <source>Language</source>
        <target>Sprache</target>
      </trans-unit>
      <trans-unit id="prepostfix_language.description" resname="prepostfix_language.description">
        <source>Language</source>
        <target>Sprache</target>
      </trans-unit>
      <trans-unit id="talias_prefix.label" resname="talias_prefix.label">
        <source>Alias prefix</source>
        <target>Alias-Präfix</target>
      </trans-unit>
      <trans-unit id="talias_prefix.description" resname="talias_prefix.description">
        <source>Optionally add a prefix term.</source>
        <target>Optionale Angabe eines Präfix für die Erstellung des Alias.</target>
      </trans-unit>
      <trans-unit id="talias_postfix.label" resname="talias_postfix.label">
        <source>Alias postfix</source>
        <target>Alias-Postfix</target>
      </trans-unit>
      <trans-unit id="talias_postfix.description" resname="talias_postfix.description">
        <source>Optionally add a postfix term.</source>
        <target>Optionale Angabe eines Postfix für die Erstellung des Alias.</target>
      </trans-unit>
      <trans-unit id="talias_fields.label" resname="talias_fields.label">
        <source>Alias fields</source>
        <target>Alias-Felder</target>
      </trans-unit>
      <trans-unit id="talias_fields.description" resname="talias_fields.description">
        <source>Please select one or more attributes to combine a alias.</source>
        <target>Bitte wählen Sie eines oder mehrere Attribute, um daraus einen Alias zu bilden.</target>
      </trans-unit>
      <trans-unit id="field_attribute.label" resname="field_attribute.label">
        <source>Attributes</source>
        <target>Attribute</target>
      </trans-unit>
      <trans-unit id="force_talias.label" resname="force_talias.label">
        <source>Force alias regenerating</source>
        <target>Neuerstellung des Alias erzwingen.</target>
      </trans-unit>
      <trans-unit id="force_talias.description" resname="force_talias.description">
        <source>Check this, if you want the alias to be regenerated whenever any of the dependant fields is changed. Note that this will invalidate old urls that are based upon the alias.</source>
        <target>Auswählen, um eine Neuerstellung des Alias zu erzwingen, wenn sich eines der abhängigen Felder ändert. Beachten Sie, dass bisherige URLs dadurch ungültig werden können.</target>
      </trans-unit>
    </body>
  </file>
</xliff>